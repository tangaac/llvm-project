; The machine combiner should reassociate chains of associative/commutative
; operations to break dependency chains (breaking the chain t0 -> t1 -> t2
; into a balanced tree), both for scalar and vector (LSX/LASX) instructions.

define double @reassoc_fadd_d(double %a0, double %a1, double %a2, double %a3) {
; CHECK-LABEL: reassoc_fadd_d:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fadd.d $fa0, $fa0, $fa1
; CHECK-NEXT:    fadd.d $fa1, $fa2, $fa3
; CHECK-NEXT:    fadd.d $fa0, $fa0, $fa1
; CHECK-NEXT:    ret
;
; NOCOMB-LABEL: reassoc_fadd_d:
; NOCOMB:       # %bb.0:
; NOCOMB-NEXT:    fadd.d $fa0, $fa0, $fa1
; NOCOMB-NEXT:    fadd.d $fa0, $fa0, $fa2
; NOCOMB-NEXT:    fadd.d $fa0, $fa0, $fa3
; NOCOMB-NEXT:    ret
  %t0 = fadd nsz reassoc double %a0, %a1
  %t1 = fadd nsz reassoc double %t0, %a2
  %t2 = fadd nsz reassoc double %t1, %a3
  ret double %t2
}

