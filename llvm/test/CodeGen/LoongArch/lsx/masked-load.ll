; CHECK-NEXT:    vinsgr2vr.w $vr1, $a0, 3
; CHECK-NEXT:    vori.b $vr0, $vr1, 0
; CHECK-NEXT:    ret
  %m = icmp sgt <4 x i32> %cmpv, splat (i32 0)
  %v = call <4 x i32> @llvm.masked.load.v4i32.p0v4i32(ptr %p, i32 4, <4 x i1> %m, <4 x i32> %pt)
  ret <4 x i32> %v
}

