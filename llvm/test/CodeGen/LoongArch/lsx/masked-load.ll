; CHECK-NEXT:  .LBB5_7:
; CHECK-NEXT:    vori.b $vr0, $vr1, 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB5_8:
; CHECK-NEXT:    ld.wu $a2, $a0, 0
; CHECK-NEXT:    vinsgr2vr.w $vr1, $a2, 0
; CHECK-NEXT:    bstrpick.d $a2, $a1, 1, 1
; CHECK-NEXT:    beq $a2, $zero, .LBB5_5
; CHECK-NEXT:  .LBB5_9:
; CHECK-NEXT:    ld.wu $a2, $a0, 4
; CHECK-NEXT:    vinsgr2vr.w $vr1, $a2, 1
; CHECK-NEXT:    bstrpick.d $a2, $a1, 2, 2
; CHECK-NEXT:    beq $a2, $zero, .LBB5_6
; CHECK-NEXT:  .LBB5_10:
; CHECK-NEXT:    ld.wu $a2, $a0, 8
; CHECK-NEXT:    vinsgr2vr.w $vr1, $a2, 2
; CHECK-NEXT:    bstrpick.d $a1, $a1, 3, 3
; CHECK-NEXT:    beq $a1, $zero, .LBB5_7
; CHECK-NEXT:  .LBB5_11:
