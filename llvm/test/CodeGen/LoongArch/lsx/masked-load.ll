; Regression: the fast path's mask!=0 skip branch must sit in its own
; block, before the full-width probe load. Without it an all-inactive
; mask probes pages the original load never accesses (segfault in
; test-suite Dilate), and a mid-block terminator loses its CFG edge to
; tail duplication ("Undefined temporary symbol .LBB...").
define <2 x i64> @mload_tail_pair(ptr %p, ptr %q, <2 x i1> %m) {
; CHECK-LABEL: mload_tail_pair:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vslli.d $vr0, $vr0, 63
; CHECK-NEXT:    vsrai.d $vr1, $vr0, 63
; CHECK-NEXT:    vrepli.b $vr0, 0
; CHECK-NEXT:    addi.d $a2, $a0, 15
; CHECK-NEXT:    xor $a2, $a2, $a0
; CHECK-NEXT:    srli.d $a2, $a2, 12
; CHECK-NEXT:    vmskltz.d $vr2, $vr1
; CHECK-NEXT:    bne $a2, $zero, .LBB6_3
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    vpickve2gr.hu $a2, $vr2, 0
; CHECK-NEXT:    beq $a2, $zero, .LBB6_7
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    vld $vr3, $a0, 0
; CHECK-NEXT:    vbitsel.v $vr0, $vr0, $vr3, $vr1
; CHECK-NEXT:    b .LBB6_7
; CHECK-NEXT:  .LBB6_3:
; CHECK-NEXT:    vpickve2gr.hu $a2, $vr2, 0
; CHECK-NEXT:    bstrpick.d $a3, $a2, 0, 0
; CHECK-NEXT:    beq $a3, $zero, .LBB6_5
; CHECK-NEXT:  # %bb.4:
; CHECK-NEXT:    ld.d $a3, $a0, 0
; CHECK-NEXT:    vinsgr2vr.d $vr0, $a3, 0
; CHECK-NEXT:  .LBB6_5:
; CHECK-NEXT:    bstrpick.d $a2, $a2, 1, 1
; CHECK-NEXT:    beq $a2, $zero, .LBB6_7
; CHECK-NEXT:  # %bb.6:
; CHECK-NEXT:    ld.d $a0, $a0, 8
; CHECK-NEXT:    vinsgr2vr.d $vr0, $a0, 1
; CHECK-NEXT:  .LBB6_7:
; CHECK-NEXT:    addi.d $a0, $a1, 15
; CHECK-NEXT:    xor $a0, $a0, $a1
; CHECK-NEXT:    srli.d $a0, $a0, 12
; CHECK-NEXT:    bne $a0, $zero, .LBB6_10
; CHECK-NEXT:  # %bb.8:
; CHECK-NEXT:    vpickve2gr.hu $a0, $vr2, 0
; CHECK-NEXT:    beq $a0, $zero, .LBB6_13
; CHECK-NEXT:  # %bb.9:
; CHECK-NEXT:    vld $vr2, $a1, 0
; CHECK-NEXT:    vbitsel.v $vr0, $vr0, $vr2, $vr1
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB6_10:
; CHECK-NEXT:    vpickve2gr.hu $a0, $vr2, 0
; CHECK-NEXT:    bstrpick.d $a2, $a0, 0, 0
; CHECK-NEXT:    beq $a2, $zero, .LBB6_12
; CHECK-NEXT:  # %bb.11:
; CHECK-NEXT:    ld.d $a2, $a1, 0
; CHECK-NEXT:    vinsgr2vr.d $vr0, $a2, 0
; CHECK-NEXT:  .LBB6_12:
; CHECK-NEXT:    bstrpick.d $a0, $a0, 1, 1
; CHECK-NEXT:    bne $a0, $zero, .LBB6_14
; CHECK-NEXT:  .LBB6_13:
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB6_14:
