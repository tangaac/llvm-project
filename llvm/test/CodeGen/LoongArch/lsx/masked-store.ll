; P0-2: masked store legalization. Fast path = mask==0 skip +
; read-modify-write (vld old value, vbitsel.v blend, vst), split into a
; check block and a store block so every terminator ends its block.
; Cold path = per-lane predicated vstelm stores (vd, rj, 0, lane-idx).

define void @mstore_v4i32(ptr %p, <4 x i1> %m, <4 x i32> %v) {
; CHECK-LABEL: mstore_v4i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vslli.w $vr0, $vr0, 31
; CHECK-NEXT:    vsrai.w $vr0, $vr0, 31
; CHECK-NEXT:    addi.d $a1, $a0, 15
; CHECK-NEXT:    xor $a1, $a1, $a0
; CHECK-NEXT:    srli.d $a1, $a1, 12
; CHECK-NEXT:    vmskltz.w $vr2, $vr0
; CHECK-NEXT:    bne $a1, $zero, .LBB0_3
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    vpickve2gr.hu $a1, $vr2, 0
; CHECK-NEXT:    beq $a1, $zero, .LBB0_7
; CHECK-NEXT:  # %bb.2:
; CHECK-NEXT:    vld $vr2, $a0, 0
; CHECK-NEXT:    vbitsel.v $vr0, $vr2, $vr1, $vr0
; CHECK-NEXT:    vst $vr0, $a0, 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_3:
; CHECK-NEXT:    vpickve2gr.hu $a1, $vr2, 0
; CHECK-NEXT:    bstrpick.d $a2, $a1, 0, 0
; CHECK-NEXT:    bne $a2, $zero, .LBB0_8
; CHECK-NEXT:  # %bb.4:
; CHECK-NEXT:    bstrpick.d $a2, $a1, 1, 1
; CHECK-NEXT:    bne $a2, $zero, .LBB0_9
; CHECK-NEXT:  .LBB0_5:
; CHECK-NEXT:    bstrpick.d $a2, $a1, 2, 2
; CHECK-NEXT:    bne $a2, $zero, .LBB0_10
; CHECK-NEXT:  .LBB0_6:
; CHECK-NEXT:    bstrpick.d $a1, $a1, 3, 3
; CHECK-NEXT:    bne $a1, $zero, .LBB0_11
; CHECK-NEXT:  .LBB0_7:
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB0_8:
; CHECK-NEXT:    vstelm.w $vr1, $a0, 0, 0
; CHECK-NEXT:    bstrpick.d $a2, $a1, 1, 1
; CHECK-NEXT:    beq $a2, $zero, .LBB0_5
; CHECK-NEXT:  .LBB0_9:
; CHECK-NEXT:    vstelm.w $vr1, $a0, 4, 1
; CHECK-NEXT:    bstrpick.d $a2, $a1, 2, 2
; CHECK-NEXT:    beq $a2, $zero, .LBB0_6
; CHECK-NEXT:  .LBB0_10:
; CHECK-NEXT:    vstelm.w $vr1, $a0, 8, 2
; CHECK-NEXT:    bstrpick.d $a1, $a1, 3, 3
; CHECK-NEXT:    beq $a1, $zero, .LBB0_7
; CHECK-NEXT:  .LBB0_11:
; CHECK-NEXT:    vstelm.w $vr1, $a0, 12, 3
; CHECK-NEXT:    ret
  call void @llvm.masked.store.v4i32.p0v4i32(<4 x i32> %v, ptr %p, i32 4, <4 x i1> %m)
  ret void
}

